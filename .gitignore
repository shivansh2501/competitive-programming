# Ignore everything by default
*

# Keep folders so Git can traverse them
!*/

# Keep C++ source files anywhere in the repo
!*.cpp
!**/*.cpp

# Keep the ignore file itself if wanted
!.gitignore

# Ignore generated / compiled artifacts
# Apple debug metadata produced by compilers; must match nested folders too
**/*.dSYM/
**/*.dSYM/**
**/.dSYM/
**/.dSYM/**

# macOS metadata files
.DS_Store
**/.DS_Store


