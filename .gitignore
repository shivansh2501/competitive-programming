# macOS System Metadata
.DS_Store

# macOS Debug Symbol Directories
*.dSYM/

# Ignore all files without extension (compiled C++ executables)
*
!*.*

# Whitelist source files, header files, and I/O test cases
!*.cpp
!*.c
!*.h
!*.hpp
!*.in
!*.out
!*.txt
!*.json
!*.md

# Whitelist setup & git configuration files
!.gitignore
!Makefile
