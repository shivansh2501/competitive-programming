# Ignore everything by default
*

# Keep directories so Git can recurse into the repo
!*/

# Keep C++ source files
!*.cpp
!**/*.cpp

# Keep the ignore file itself
!.gitignore

# Ignore Apple debug metadata at any depth
*.dSYM/
*.dSYM/**
**/*.dSYM/
**/*.dSYM/**
**/.dSYM/
**/.dSYM/**

# Ignore macOS metadata
.DS_Store
**/.DS_Store


