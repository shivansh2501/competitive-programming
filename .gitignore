# macOS System Metadata & Debug Folders
.DS_Store
*.dSYM/

# Ignore all extensionless compiled binaries (top-level and subfolders)
*
!*/
!*.*

# Explicitly ignore compiled object/library files
*.o
*.out

# Whitelist source, header, test I/O, and config files
!*.cpp
!*.c
!*.h
!*.hpp
!*.in
!*.txt
!*.json
!*.md
!.gitignore
!Makefile


